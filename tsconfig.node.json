{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/main/rpgmaker/lz-string-mv.fixture.js",
    "src/main/f95/parser/test-harness.ts",
    "src/main/f95/parser/propagate-samples.ts",
    "src/main/f95/parser/update-samples.ts",
    "src/main/f95/parser/fetch-samples.ts",
    "src/main/f95/parser/vitest-setup.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}